rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isCommunityMember(communityId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }

    function isCommunityMemberAfter(communityId) {
      return signedIn() &&
        existsAfter(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }

    function isPlaceCustodian(placeId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/places/$(placeId)).data.custodianIds;
    }

    function isVisibleMemory(memory) {
      return signedIn() &&
        memory.isDeleted == false &&
        (
          memory.privacy == 'public' ||
          memory.userId == request.auth.uid ||
          (memory.privacy == 'tagged' && request.auth.uid in memory.taggedUserIds) ||
          (memory.privacy == 'timeRelease' && memory.releaseDate <= request.time) ||
          (memory.privacy == 'community' && isCommunityMember(memory.communityId))
        );
    }

    function immutableMemoryFieldsUnchanged() {
      return request.resource.data.userId == resource.data.userId &&
        request.resource.data.placeId == resource.data.placeId &&
        request.resource.data.latitude == resource.data.latitude &&
        request.resource.data.longitude == resource.data.longitude &&
        request.resource.data.geohash == resource.data.geohash &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function mutableMemoryEditOnly() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly([
          'textContent',
          'privacy',
          'taggedUserIds',
          'communityId',
          'releaseDate',
          'imageUrl',
          'audioUrl',
          'updatedAt'
        ]);
    }

    function softDeleteOnly() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(['isDeleted', 'deletedAt', 'updatedAt']) &&
        resource.data.isDeleted == false &&
        request.resource.data.isDeleted == true;
    }

    function restoreOnly() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(['isDeleted', 'deletedAt', 'updatedAt']) &&
        resource.data.isDeleted == true &&
        request.resource.data.isDeleted == false &&
        resource.data.userId == request.auth.uid &&
        resource.data.deletedAt != null &&
        request.time < resource.data.deletedAt + duration.value(30, 'd');
    }

    match /users/{userId} {
      allow create: if isSelf(userId);
      allow read: if signedIn();
      allow update, delete: if isSelf(userId);
    }

    match /places/{placeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.custodianIds;
      allow update: if isPlaceCustodian(placeId);
      allow delete: if false;
    }

    match /memories/{memoryId} {
      allow get, list: if isVisibleMemory(resource.data) ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.isDeleted == false;
      allow update: if signedIn() &&
        immutableMemoryFieldsUnchanged() &&
        (
          (
            resource.data.userId == request.auth.uid &&
            mutableMemoryEditOnly()
          ) ||
          (
            (resource.data.userId == request.auth.uid || isPlaceCustodian(resource.data.placeId)) &&
            softDeleteOnly()
          ) ||
          (
            resource.data.userId == request.auth.uid &&
            restoreOnly()
          )
        );
      allow delete: if false;
    }

    match /communities/{communityId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isCommunityMember(communityId) || isCommunityMemberAfter(communityId);
      allow delete: if false;

      match /members/{userId} {
        allow read: if isCommunityMember(communityId) || isSelf(userId);
        allow create: if isSelf(userId) ||
          get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid ||
          getAfter(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid;
        allow update: if get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid;
        allow delete: if isSelf(userId) || get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid;
      }
    }

    match /institutions/{institutionId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.verifiedAdminUserIds;
      allow update: if signedIn() &&
        request.auth.uid in resource.data.verifiedAdminUserIds;
      allow delete: if false;
    }

    match /places/{placeId}/auraHistory/{entryId} {
      allow read: if signedIn();
      allow create: if signedIn() && isPlaceCustodian(placeId);
      allow update, delete: if false;
    }

    match /transfers/{transferId} {
      allow read: if signedIn() &&
        (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.fromUserId == request.auth.uid &&
        isPlaceCustodian(request.resource.data.placeId);
      allow update: if signedIn() &&
        (
          resource.data.toUserId == request.auth.uid ||
          resource.data.fromUserId == request.auth.uid
        );
      allow delete: if false;
    }

    match /notificationRequests/{requestId} {
      allow read: if false;
      allow create: if signedIn() &&
        (
          request.resource.data.data.fromUserId == request.auth.uid ||
          request.resource.data.data.toUserId == request.auth.uid
        );
      allow update, delete: if false;
    }
  }
}
