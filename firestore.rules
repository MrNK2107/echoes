rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isCommunityMember(communityId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }

    function isCommunityMemberAfter(communityId) {
      return signedIn() &&
        existsAfter(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }

    function isPlaceCustodian(placeId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/places/$(placeId)).data.custodianIds;
    }

    function isVisibleMemory(memory) {
      return signedIn() &&
        memory.isDeleted == false &&
        (
          memory.privacy == 'public' ||
          memory.userId == request.auth.uid ||
          (memory.privacy == 'tagged' && request.auth.uid in memory.taggedUserIds) ||
          (memory.privacy == 'timeRelease' && memory.releaseDate <= request.time) ||
          (memory.privacy == 'community' && isCommunityMember(memory.communityId))
        );
    }

    function immutableMemoryFieldsUnchanged() {
      return request.resource.data.userId == resource.data.userId &&
        request.resource.data.placeId == resource.data.placeId &&
        request.resource.data.latitude == resource.data.latitude &&
        request.resource.data.longitude == resource.data.longitude &&
        request.resource.data.geohash == resource.data.geohash &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function unitInterval(n) {
      return n is number && n >= 0 && n <= 1;
    }

    // Sentiment feeds the place aura; out-of-range or non-numeric values would skew it for
    // everyone (functions/onMemoryWritten.js clamps as well). NaN fails every comparison.
    function validSentiment(sentiment) {
      return sentiment is map &&
        sentiment.compound is number &&
        sentiment.compound >= -1 &&
        sentiment.compound <= 1 &&
        unitInterval(sentiment.positive) &&
        unitInterval(sentiment.neutral) &&
        unitInterval(sentiment.negative);
    }

    // Media URLs are rendered for every viewer, so they must be this backend's own Storage
    // download URLs for the author's folder (memory-images/<uid>/ or memory-audio/<uid>/), never
    // an arbitrary host that could track viewers. Accepted hosts:
    //   - https://firebasestorage.googleapis.com (production getDownloadURL)
    //   - http://<loopback | 10.0.2.2 | private LAN IPv4>:9199 (the Storage emulator, reached from
    //     a simulator or a device on the dev machine's LAN; such hosts are not reachable trackers)
    // The bucket segment is not pinned: Firestore rules cannot see the project id.
    function storageUrlPrefix() {
      return '^(https://firebasestorage[.]googleapis[.]com' +
        '|http://(127[.]0[.]0[.]1|localhost|10[.]0[.]2[.]2|10([.][0-9]{1,3}){3}|192[.]168([.][0-9]{1,3}){2}|172[.](1[6-9]|2[0-9]|3[01])([.][0-9]{1,3}){2}):9199)' +
        '/v0/b/[^/?#]+/o/';
    }

    function validMediaUrl(url, folder, userId) {
      return url == null ||
        (url is string &&
          url.matches(storageUrlPrefix() + folder + '%2F' + userId + '%2F[^/?#]+([?].*)?$'));
    }

    function validMemoryMedia(data) {
      return validMediaUrl(data.get('imageUrl', null), 'memory-images', data.userId) &&
        validMediaUrl(data.get('audioUrl', null), 'memory-audio', data.userId);
    }

    function mutableMemoryEditOnly() {
      return resource.data.isDeleted == false &&
        validSentiment(request.resource.data.sentiment) &&
        validMemoryMedia(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'textContent',
          'privacy',
          'taggedUserIds',
          'communityId',
          'releaseDate',
          'sentiment',
          'imageUrl',
          'audioUrl',
          'updatedAt'
        ]);
    }

    // Ruling R13: deletion times come from the server clock (clients write serverTimestamp()), so
    // nobody, including a place custodian acting on another user's memory, can backdate a delete
    // past the restore window or future-date it out of reach of the purge.
    function softDeleteOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['isDeleted', 'deletedAt', 'updatedAt']) &&
        resource.data.isDeleted == false &&
        request.resource.data.isDeleted == true &&
        request.resource.data.deletedAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function restoreOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['isDeleted', 'deletedAt', 'updatedAt']) &&
        resource.data.isDeleted == true &&
        request.resource.data.isDeleted == false &&
        request.resource.data.deletedAt == null &&
        request.resource.data.updatedAt == request.time &&
        resource.data.userId == request.auth.uid &&
        resource.data.deletedAt != null &&
        request.time < resource.data.deletedAt + duration.value(30, 'd');
    }

    match /users/{userId} {
      allow create: if isSelf(userId);
      allow read: if signedIn();
      allow update, delete: if isSelf(userId);
    }

    match /places/{placeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.custodianIds;
      allow update: if isPlaceCustodian(placeId);
      allow delete: if false;
    }

    match /memories/{memoryId} {
      allow get, list: if isVisibleMemory(resource.data) ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.isDeleted == false &&
        validSentiment(request.resource.data.sentiment) &&
        validMemoryMedia(request.resource.data);
      allow update: if signedIn() &&
        immutableMemoryFieldsUnchanged() &&
        (
          (
            resource.data.userId == request.auth.uid &&
            mutableMemoryEditOnly()
          ) ||
          (
            (resource.data.userId == request.auth.uid || isPlaceCustodian(resource.data.placeId)) &&
            softDeleteOnly()
          ) ||
          (
            resource.data.userId == request.auth.uid &&
            restoreOnly()
          )
        );
      allow delete: if false;
    }

    match /communities/{communityId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isCommunityMember(communityId) || isCommunityMemberAfter(communityId);
      allow delete: if false;

      match /members/{userId} {
        allow read: if isCommunityMember(communityId) || isSelf(userId);
        allow create: if isSelf(userId) ||
          get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid ||
          getAfter(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid;
        allow update: if get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid;
        allow delete: if isSelf(userId) || get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid;
      }
    }

    match /institutions/{institutionId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.verifiedAdminUserIds;
      allow update: if signedIn() &&
        request.auth.uid in resource.data.verifiedAdminUserIds;
      allow delete: if false;
    }

    match /places/{placeId}/auraHistory/{entryId} {
      allow read: if signedIn();
      allow create: if signedIn() && isPlaceCustodian(placeId);
      allow update, delete: if false;
    }

    match /transfers/{transferId} {
      allow read: if signedIn() &&
        (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.fromUserId == request.auth.uid &&
        isPlaceCustodian(request.resource.data.placeId);
      allow update: if signedIn() &&
        (
          resource.data.toUserId == request.auth.uid ||
          resource.data.fromUserId == request.auth.uid
        );
      allow delete: if false;
    }

    match /notificationRequests/{requestId} {
      allow read: if false;
      allow create: if signedIn() &&
        (
          request.resource.data.data.fromUserId == request.auth.uid ||
          request.resource.data.data.toUserId == request.auth.uid
        );
      allow update, delete: if false;
    }
  }
}
