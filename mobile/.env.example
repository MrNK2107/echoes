# Backend: memory (default, seeded demo data, no network) | emulator | firebase
EXPO_PUBLIC_BACKEND=memory

# emulator mode: host running the Firebase emulators. Use your PC's LAN IP when testing on a physical phone.
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1

# firebase mode only: values from the Firebase console (Project settings > Your apps).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Registration links (ADR-0008). Leave empty for the defaults https://echoes.app/terms and https://echoes.app/guidelines.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_GUIDELINES_URL=
