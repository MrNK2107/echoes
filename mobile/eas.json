{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_BACKEND": "emulator" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_BACKEND": "firebase" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_BACKEND": "firebase" }
    }
  }
}
