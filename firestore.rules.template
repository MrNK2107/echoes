rules_version = '2';

// @@GENERATED_HEADER@@

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isCommunityMember(communityId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }

    function isPlaceCustodian(placeId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/places/$(placeId)).data.custodianIds;
    }

    // Hidden memories (moderation == 'hidden', set by reportMemory after 3 reports) are excluded
    // here for everyone; the separate own-read clause on /memories keeps them readable by their
    // author. List queries prove this branch with where('moderation', '==', null).
    function isVisibleMemory(memory) {
      return signedIn() &&
        memory.isDeleted == false &&
        memory.moderation != 'hidden' &&
        (
          memory.privacy == 'public' ||
          memory.userId == request.auth.uid ||
          (memory.privacy == 'tagged' && request.auth.uid in memory.taggedUserIds) ||
          (memory.privacy == 'timeRelease' && memory.releaseDate <= request.time) ||
          (memory.privacy == 'community' && isCommunityMember(memory.communityId))
        );
    }

    function immutableMemoryFieldsUnchanged() {
      return request.resource.data.userId == resource.data.userId &&
        request.resource.data.placeId == resource.data.placeId &&
        request.resource.data.latitude == resource.data.latitude &&
        request.resource.data.longitude == resource.data.longitude &&
        request.resource.data.geohash == resource.data.geohash &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function unitInterval(n) {
      return n is number && n >= 0 && n <= 1;
    }

    // Sentiment feeds the place aura; out-of-range or non-numeric values would skew it for
    // everyone (functions/onMemoryWritten.js clamps as well). NaN fails every comparison.
    function validSentiment(sentiment) {
      return sentiment is map &&
        sentiment.compound is number &&
        sentiment.compound >= -1 &&
        sentiment.compound <= 1 &&
        unitInterval(sentiment.positive) &&
        unitInterval(sentiment.neutral) &&
        unitInterval(sentiment.negative);
    }

    // Media URLs are rendered for every viewer, so they must be this backend's own Storage
    // download URLs (pinned bucket) for the author's folder (memory-images/<uid>/ or
    // memory-audio/<uid>/), never an arbitrary host that could track viewers (ruling R18).
    // The function below is generated by scripts/build-rules.js:
    //   firestore.rules      https://firebasestorage.googleapis.com and the loopback Storage emulator
    //   firestore.lan.rules  the same plus private-LAN and 10.0.2.2 emulator hosts (firebase.lan.json)
    //   production deploy    `build-rules.js --prod`: googleapis only, no emulator hosts at all
// @@STORAGE_URL_PREFIX@@

    function validMediaUrl(url, folder, userId) {
      return url == null ||
        (url is string &&
          url.matches(storageUrlPrefix() + folder + '%2F' + userId + '%2F[^/?#]+([?].*)?$'));
    }

    function validMemoryMedia(data) {
      return validMediaUrl(data.get('imageUrl', null), 'memory-images', data.userId) &&
        validMediaUrl(data.get('audioUrl', null), 'memory-audio', data.userId);
    }

    // Ruling R24: at most MAX_TAGS (mobile/src/domain/privacy.ts) tagged users.
    function validTags(data) {
      return data.taggedUserIds is list && data.taggedUserIds.size() <= 20;
    }

    // Only members may share a memory with a community (its feed and members can see it).
    function validCommunityShare(data) {
      return data.privacy != 'community' ||
        (data.communityId is string && isCommunityMember(data.communityId));
    }

    // `moderation` and `flags` are server-written (reportMemory, onMemoryWritten) and appear in no
    // client-writable list below.
    function mutableMemoryEditOnly() {
      return resource.data.isDeleted == false &&
        validSentiment(request.resource.data.sentiment) &&
        validMemoryMedia(request.resource.data) &&
        validTags(request.resource.data) &&
        validCommunityShare(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'textContent',
          'privacy',
          'taggedUserIds',
          'communityId',
          'releaseDate',
          'sentiment',
          'imageUrl',
          'audioUrl',
          'updatedAt'
        ]);
    }

    // The keys mobile/src/data/mappers.ts memoryToDoc writes.
    function validNewMemoryKeys(data) {
      return data.keys().hasOnly([
        'userId',
        'placeId',
        'imageUrl',
        'audioUrl',
        'textContent',
        'latitude',
        'longitude',
        'geohash',
        'sentiment',
        'privacy',
        'taggedUserIds',
        'communityId',
        'releaseDate',
        'isDeleted',
        'deletedAt',
        'moderation',
        'createdAt',
        'updatedAt'
      ]);
    }

    // Ruling R13: deletion times come from the server clock (clients write serverTimestamp()), so
    // nobody, including a place custodian acting on another user's memory, can backdate a delete
    // past the restore window or future-date it out of reach of the purge.
    function softDeleteOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['isDeleted', 'deletedAt', 'updatedAt']) &&
        resource.data.isDeleted == false &&
        request.resource.data.isDeleted == true &&
        request.resource.data.deletedAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function restoreOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['isDeleted', 'deletedAt', 'updatedAt']) &&
        resource.data.isDeleted == true &&
        request.resource.data.isDeleted == false &&
        request.resource.data.deletedAt == null &&
        request.resource.data.updatedAt == request.time &&
        resource.data.userId == request.auth.uid &&
        resource.data.deletedAt != null &&
        request.time < resource.data.deletedAt + duration.value(30, 'd');
    }

    function validNotificationPrefs(prefs) {
      return prefs is map &&
        prefs.keys().hasOnly(['transfers', 'tags', 'communityInvites']) &&
        prefs.transfers is bool &&
        prefs.tags is bool &&
        prefs.communityInvites is bool;
    }

    // Owner-writable user fields (mappers.ts userToDoc plus the Plan 3 additions). Anything else
    // on a user doc is server-written.
    function userKeys() {
      return [
        'displayName',
        'email',
        'photoUrl',
        'defaultPrivacy',
        'managedPlaceIds',
        'communityIds',
        'createdAt',
        'updatedAt',
        'notificationPrefs',
        'acceptedTermsAt'
      ];
    }

    function validUserFields(data) {
      return (!('notificationPrefs' in data) || validNotificationPrefs(data.notificationPrefs)) &&
        (!('acceptedTermsAt' in data) || data.acceptedTermsAt is string);
    }

    // User docs hold the account email, so only the owner may read them. The app reads only the
    // signed-in user's doc; functions use the Admin SDK, which bypasses these rules.
    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId) &&
        request.resource.data.keys().hasOnly(userKeys()) &&
        validUserFields(request.resource.data);
      allow update: if isSelf(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(userKeys()) &&
        validUserFields(request.resource.data);
      allow delete: if isSelf(userId);

      // In-app inbox, written by functions/lib/notify.js. The owner may only mark items read.
      match /notifications/{notificationId} {
        allow read: if isSelf(userId);
        allow update: if isSelf(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
          request.resource.data.readAt is string;
        allow create, delete: if false;
      }

      // Expo push tokens for this user's devices (ADR-0009). tokenId is the first 32 hex chars of
      // the SHA-256 of the token. Read by functions/push.js via the Admin SDK.
      match /pushTokens/{tokenId} {
        allow read, delete: if isSelf(userId);
        allow create: if isSelf(userId) &&
          tokenId.matches('^[0-9a-f]{32}$') &&
          request.resource.data.keys().hasOnly(['token', 'platform', 'createdAt', 'lastSeenAt']) &&
          request.resource.data.keys().hasAll(['token', 'platform', 'createdAt', 'lastSeenAt']) &&
          request.resource.data.token is string &&
          request.resource.data.token.size() <= 256 &&
          request.resource.data.token.matches('^Expo(nent)?PushToken\\[[A-Za-z0-9_-]+\\]$') &&
          request.resource.data.platform in ['ios', 'android'] &&
          request.resource.data.createdAt is string &&
          request.resource.data.lastSeenAt is string;
        allow update: if isSelf(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt']) &&
          request.resource.data.lastSeenAt is string;
      }

      // Callables read both directions of a block, so blocks stay owner-only data.
      match /blocks/{otherUserId} {
        allow read, delete: if isSelf(userId);
        allow create, update: if isSelf(userId) &&
          otherUserId != userId &&
          request.resource.data.keys().hasOnly(['createdAt']) &&
          request.resource.data.createdAt is string;
      }
    }

    function validPublicProfile(data) {
      return data.keys().hasOnly(['displayName', 'displayNameLower', 'updatedAt']) &&
        data.displayName is string &&
        // size() does not count code points (an emoji counts more than once), but RE2's '.'
        // matches one code point, as mobile/src/domain/profiles.ts counts. No line breaks.
        data.displayName.matches('^.{2,40}$') &&
        data.displayName == data.displayName.trim() &&
        data.displayNameLower is string &&
        data.displayNameLower.size() <= 400 &&
        data.updatedAt is string;
    }

    // Names other people see (search, tagging, notifications). No email or other private data.
    match /publicProfiles/{userId} {
      // Bounded listing (Plan 5): search and getMany pages carry limit(<= 30); no full scans.
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 30;
      allow create, update: if isSelf(userId) && validPublicProfile(request.resource.data);
      allow delete: if false;
    }

    function validNewPlace(data) {
      return data.keys().hasOnly([
          'name',
          'latitude',
          'longitude',
          'geohash',
          'communityId',
          'custodianIds',
          'aura',
          'memoryCount',
          'publicMemoryCount',
          'createdAt',
          'updatedAt'
        ]) &&
        // The only name the client writes (submitMemory.ts); renaming is a future server feature.
        data.name == 'Memory Place' &&
        data.latitude is number &&
        data.longitude is number &&
        data.geohash is string &&
        data.custodianIds == [request.auth.uid] &&
        data.memoryCount == 0 &&
        data.publicMemoryCount == 0 &&
        data.communityId == null &&
        data.aura is map &&
        data.aura.keys().hasOnly([
          'dominantSentiment',
          'compoundScore',
          'intensity',
          'memoryCount',
          'colorHex',
          'updatedAt'
        ]) &&
        data.aura.memoryCount == 0 &&
        data.aura.intensity == 0;
    }

    // Clients only create an empty place for their first memory there. Aggregates, auras,
    // communityId and custodianIds (transfers) are written by functions only.
    match /places/{placeId} {
      allow read: if signedIn();
      allow create: if signedIn() && validNewPlace(request.resource.data);
      allow update, delete: if false;

      // Appended by onMemoryWritten.
      match /auraHistory/{entryId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /memories/{memoryId} {
      allow get, list: if isVisibleMemory(resource.data) ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.isDeleted == false &&
        request.resource.data.moderation == null &&
        validNewMemoryKeys(request.resource.data) &&
        validSentiment(request.resource.data.sentiment) &&
        validMemoryMedia(request.resource.data) &&
        validTags(request.resource.data) &&
        validCommunityShare(request.resource.data);
      allow update: if signedIn() &&
        immutableMemoryFieldsUnchanged() &&
        (
          (
            resource.data.userId == request.auth.uid &&
            mutableMemoryEditOnly()
          ) ||
          (
            (resource.data.userId == request.auth.uid || isPlaceCustodian(resource.data.placeId)) &&
            softDeleteOnly()
          ) ||
          (
            resource.data.userId == request.auth.uid &&
            restoreOnly()
          )
        );
      allow delete: if false;
    }

    // ADR-0007: communities, memberships, transfers and institutions change only through
    // callables (Admin SDK). Clients read them.
    match /communities/{communityId} {
      allow read: if signedIn();
      allow write: if false;

      match /members/{memberId} {
        allow read: if isCommunityMember(communityId) || isSelf(memberId);
        allow write: if false;
      }
    }

    match /transfers/{transferId} {
      allow read: if signedIn() &&
        (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow write: if false;
    }

    match /institutions/{institutionId} {
      allow read: if signedIn();
      allow write: if false;

      // Plan 5: who administers an institution is private. Each admin reads only their own doc
      // (the client's admin UI); written by claimInstitutionAdmin (Admin SDK).
      match /admins/{adminId} {
        allow read: if isSelf(adminId);
        allow write: if false;
      }
    }

    // Server-only collections (ADR-0008 reports, callable rate limits, legacy push requests).
    match /reports/{reportId} {
      allow read, write: if false;
    }

    match /rateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /notificationRequests/{requestId} {
      allow read, write: if false;
    }
  }
}
